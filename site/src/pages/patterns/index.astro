---
import Base from '../../layouts/Base.astro'
import { getPatterns, inlineCode } from '../../lib/patterns'

const patterns = await getPatterns()
---

<Base
	title="Patterns — Karkas"
	description="Problems the template already solves: the failure users would hit, the decision the shipped mechanism encodes, and where to read it in the code."
>
	<section class="section-pad">
		<div class="wrap">
			<a class="tlink back" href="/">← Back to Karkas</a>
			<div class="section-head arc-head">
				<span class="tag tag--steel">Patterns</span>
				<h1>Problems you were about to solve worse.</h1>
				<p>
					Each entry is a mechanism taken from a production app and shipped in the template. It
					names the failure it prevents, the decision the code makes (what stays mounted, what
					clears when, who owns the state after a save), and the files to read. Projects started
					from the template get the code and the comments that explain it.
				</p>
			</div>

			{
				patterns.length > 0 ? (
					<ul class="feed">
						{patterns.map((p) => (
							<li class="feed-item">
								<div class="feed-meta">
									<span class="feed-tag">{p.data.tag}</span>
								</div>
								<a class="feed-title" href={`/patterns/${p.id}`}>
									{p.data.title}
								</a>
								<p class="feed-problem" set:html={inlineCode(p.data.problem)} />
								<p class="feed-decision" set:html={inlineCode(p.data.decision)} />
								<div class="feed-files">
									{p.data.demo && <a class="tlink" href={p.data.demo}>see it running →</a>}
									<a class="tlink" href={`/patterns/${p.id}`}>read the decision →</a>
								</div>
							</li>
						))}
					</ul>
				) : (
					<p class="feed-empty">No patterns published yet.</p>
				)
			}
		</div>
	</section>
</Base>

<style>
	.back {
		display: inline-block;
		margin-bottom: 2.2rem;
	}
	.feed-problem {
		color: var(--ink-muted);
		margin: 0 0 0.6rem;
	}
	.feed-decision {
		font-size: 0.92rem;
		color: var(--ink);
		border-left: 3px solid var(--steel);
		padding-left: 0.9rem;
		margin: 0 0 0.9rem;
	}
	.feed-files {
		display: flex;
		gap: 1.4rem;
	}
	.feed-files :global(.tlink) {
		font-size: 0.85rem;
	}
</style>
